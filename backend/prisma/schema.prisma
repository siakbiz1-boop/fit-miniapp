generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // В Prisma 6 тут можно url. Если у тебя Prisma 7 и оно ругается — скажи, дам версию под prisma.config.ts
  url      = env("DATABASE_URL")
}

enum UserRole {
  trainer
  client
}

enum ClientStatus {
  pending
  active
}

model User {
  id        Int      @id @default(autoincrement())
  tgUserId  BigInt   @unique
  username  String?
  firstName String?
  lastName  String?
  role      UserRole?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id               String   @id
  trainerTgUserId  BigInt
  clientUsername   String
  clientName       String?
  startAt          DateTime
  endAt            DateTime
  startTime        String
  endTime          String
  type             String?
  remindAt         DateTime
  remindedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([trainerTgUserId, startAt])
  @@index([remindAt])
}

model TrainerClient {
  id                 String        @id @default(cuid())
  trainerTgUserId    BigInt
  clientUsername     String
  code               String
  status             ClientStatus  @default(pending)
  archived           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  fullName           String?
  height             String?
  weight             String?
  goal               String?
  comment            String?

  subscriptionStart  String?
  subscriptionEnd    String?
  subscriptionPrice  String?
  subscriptionTotal  String?
  subscriptionLeft   String?

  exercises          ClientExercise[]

  @@unique([trainerTgUserId, clientUsername])
  @@unique([trainerTgUserId, code])
  @@index([trainerTgUserId])
}

model ClientExercise {
  id         String        @id @default(cuid())
  clientId   String
  name       String
  weight     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client     TrainerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}
