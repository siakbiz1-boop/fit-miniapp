generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // В Prisma 6 тут можно url. Если у тебя Prisma 7 и оно ругается — скажи, дам версию под prisma.config.ts
  url      = env("DATABASE_URL")
}

enum UserRole {
  trainer
  client
}

enum ClientStatus {
  pending
  active
}

enum BookingMode {
  trainer
  both
}

enum SessionSource {
  trainer
  client
}

model User {
  id        Int      @id @default(autoincrement())
  tgUserId  BigInt   @unique
  username  String?
  firstName String?
  lastName  String?
  photoUrl  String?
  role      UserRole?
  theme     String?
  language  String?
  reminderHours Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainerProfile TrainerProfile?
}

model TrainingSession {
  id               String   @id
  trainerTgUserId  BigInt
  clientUsername   String
  clientName       String?
  startAt          DateTime
  endAt            DateTime
  startTime        String
  endTime          String
  type             String?
  price            String?
  comment          String?
  color            String?
  source           SessionSource @default(trainer)
  remindAt         DateTime
  remindedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  participants     GroupSessionParticipant[]

  @@index([trainerTgUserId, startAt])
  @@index([remindAt])
}

model GroupSessionParticipant {
  id             String   @id @default(cuid())
  sessionId      String
  clientId       String
  clientUsername String
  clientName     String?
  createdAt      DateTime @default(now())
  remindedAt     DateTime?

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([clientId])
  @@index([clientUsername])
}

model TrainerProfile {
  id             String   @id @default(cuid())
  userId         Int      @unique
  fullName       String?
  fitnessClub    String?
  specialization String?
  experience     String?
  about          String?
  requirements   String?
  extraInfo      String?
  phone          String?
  instagram      String?
  otherSocial    String?
  bookingMode    BookingMode @default(trainer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainerNoteList {
  id              String   @id @default(cuid())
  trainerTgUserId BigInt
  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items TrainerNoteItem[]

  @@index([trainerTgUserId])
}

model TrainerNoteItem {
  id        String   @id @default(cuid())
  listId    String
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list TrainerNoteList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model TrainerClient {
  id                 String        @id @default(cuid())
  trainerTgUserId    BigInt
  clientUsername     String
  clientTgUserId     BigInt?
  code               String
  status             ClientStatus  @default(pending)
  archived           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  fullName           String?
  gender             String?
  height             String?
  weight             String?
  goal               String?
  comment            String?
  contactTelegram    String?
  contactPhone       String?
  contactInstagram   String?
  contactOtherSocial String?

  subscriptionStart  String?
  subscriptionEnd    String?
  subscriptionPrice  String?
  subscriptionTotal  String?
  subscriptionLeft   String?

  exercises          ClientExercise[]
  exerciseHistory    ClientExerciseHistory[]

  @@unique([trainerTgUserId, clientUsername])
  @@unique([trainerTgUserId, code])
  @@index([trainerTgUserId])
}

model ClientExercise {
  id         String        @id @default(cuid())
  clientId   String
  name       String
  weight     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client     TrainerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  history    ClientExerciseHistory[]

  @@index([clientId])
}

model ClientExerciseHistory {
  id         String      @id @default(cuid())
  clientId   String
  exerciseId String
  value      String
  recordedAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  client   TrainerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exercise ClientExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([clientId, exerciseId, recordedAt])
}

model TrainingSlot {
  id              String   @id @default(cuid())
  trainerTgUserId BigInt
  dateKey         String
  start           String
  end             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trainerTgUserId, dateKey])
  @@unique([trainerTgUserId, dateKey, start, end])
}

model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  planId         String
  planName       String
  months         Int
  grantsFree     Boolean  @default(true)
  usedByTgUserId BigInt?
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([planId, months])
  @@index([usedAt])
}
